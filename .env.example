# ---------------------------------------------------------------------------
# Chat / generation provider: "openai" | "ollama"
# - openai: needs OPENAI_API_KEY
# - ollama: local, free (install https://ollama.com and pull a model)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Required when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
# Get a key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Embedding backend: "openai" | "huggingface"
# - openai:       paid API, strong quality (needs OPENAI_API_KEY)
# - huggingface:  runs locally via sentence-transformers (no key required)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface

# Optional model overrides (defaults shown)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Retrieval tuning
# RETRIEVAL_SEARCH_TYPE=mmr
# RETRIEVAL_K=4
# RETRIEVAL_FETCH_K=8
# MIN_RELEVANCE_SCORE=0.3

# Optional: LangSmith tracing (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-rag-tutorial
