# ---------------------------------------------------------------------------
# Required for OpenAI embeddings AND for answering questions with ChatOpenAI
# Get a key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# Embedding backend: "openai" | "huggingface"
# - openai:       paid API, strong quality (needs OPENAI_API_KEY)
# - huggingface:  runs locally via sentence-transformers (no key required)
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=huggingface

# Optional model overrides (defaults shown)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chat model used only at query time (needs OPENAI_API_KEY)
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: LangSmith tracing (https://smith.langchain.com)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=langchain-rag-tutorial
